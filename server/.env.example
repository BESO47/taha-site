# =====================================================================
# Physics Hub — Bulk WhatsApp gateway configuration
# Copy to `server/.env` and edit.
# =====================================================================

# ---- HTTP server ----
PORT=4000
HOST=0.0.0.0
# Shared secret the admin dashboard must send as `x-api-key`.
# Leave empty for local development, ALWAYS set it in production.
WA_API_KEY=
# Comma separated list, or * for any origin (dev only).
WA_ALLOWED_ORIGINS=http://localhost:5173

# ---- Transport ----
# whatsapp-web  -> free QR session (recommended, no Meta account needed)
# cloud-api     -> official Meta WhatsApp Cloud API
# webhook       -> relay to UltraMsg / Green API / Baileys service / n8n
# mock          -> dry-run, logs instead of sending (for testing)
WA_PROVIDER=whatsapp-web

# ---- whatsapp-web.js options ----
WA_SESSION_ID=physics-hub
WA_SESSION_DIR=./.wwebjs_auth
WA_HEADLESS=true
WA_AUTO_START=true
WA_PRINT_QR=true
# Only needed if Puppeteer's bundled Chromium is not used:
# WA_CHROMIUM_PATH=/usr/bin/chromium

# ---- Meta WhatsApp Cloud API (WA_PROVIDER=cloud-api) ----
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_API_VERSION=v20.0
# Set a template name when messaging outside the 24h window
WA_CLOUD_TEMPLATE=
WA_CLOUD_TEMPLATE_LANG=ar

# ---- Generic relay (WA_PROVIDER=webhook) ----
WA_WEBHOOK_URL=
WA_WEBHOOK_METHOD=POST
WA_WEBHOOK_AUTH_HEADER=
WA_WEBHOOK_AUTH_VALUE=
WA_WEBHOOK_TIMEOUT_MS=20000

# ---- Dispatch safety (anti-ban pacing) ----
WA_DEFAULT_DELAY_MS=4000      # base delay between messages
WA_DEFAULT_JITTER_MS=2000     # random extra delay (0-2s) so timing looks human
WA_BATCH_SIZE=25              # cool down after this many messages
WA_BATCH_PAUSE_MS=60000       # length of the cool-down
WA_MAX_RETRIES=2              # retries per recipient on transient errors
WA_RETRY_BACKOFF_MS=5000
WA_MAX_RECIPIENTS=1000        # hard cap per job
WA_VERIFY_NUMBERS=true        # skip numbers that are not on WhatsApp
WA_DEFAULT_COUNTRY_CODE=20    # Egypt
