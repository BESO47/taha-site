# HTTP
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
TRUST_PROXY=false
WA_ALLOWED_ORIGINS=http://localhost:5173
WA_RATE_LIMIT_WINDOW_MS=60000
WA_RATE_LIMIT_MAX=120

# Authentication (recommended for browser dashboard requests)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
WA_AUTH_CACHE_MS=30000

# Optional server-to-server credential. Do not place this value in Vite/browser env.
WA_API_KEY=

# Only for a local request arriving from loopback; startup refuses this in production.
WA_ALLOW_INSECURE_LOCAL=false

# Transport: cloud-api | webhook | mock | whatsapp-web
WA_PROVIDER=mock
WA_AUTO_START=true

# Meta WhatsApp Cloud API
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_API_VERSION=v20.0
WA_CLOUD_TEMPLATE=
WA_CLOUD_TEMPLATE_LANG=ar

# Generic trusted relay (server-side only)
WA_WEBHOOK_URL=
WA_WEBHOOK_METHOD=POST
WA_WEBHOOK_AUTH_HEADER=
WA_WEBHOOK_AUTH_VALUE=
WA_WEBHOOK_TIMEOUT_MS=20000

# Optional whatsapp-web provider. The dependency is intentionally not bundled
# while its Chromium extraction chain has an unresolved security advisory.
WA_SESSION_ID=physics-hub
WA_SESSION_DIR=.wwebjs_auth
WA_HEADLESS=true
WA_PRINT_QR=false
WA_CHROMIUM_PATH=

# Dispatch limits and pacing
WA_DEFAULT_DELAY_MS=4000
WA_DEFAULT_JITTER_MS=2000
WA_BATCH_SIZE=25
WA_BATCH_PAUSE_MS=60000
WA_MAX_RETRIES=2
WA_RETRY_BACKOFF_MS=5000
WA_MAX_RECIPIENTS=1000
WA_MAX_QUEUED_JOBS=10
WA_VERIFY_NUMBERS=true
WA_DEFAULT_COUNTRY_CODE=20
# HTTP JSON body cap for /api/whatsapp/bulk payloads
# (must fit maxRecipientsPerJob × message size; ~10mb covers 1000 × 4 KB)
WA_JSON_BODY_LIMIT=10mb
