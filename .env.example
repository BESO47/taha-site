# Supabase project credentials (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: automated WhatsApp sending.
# Leave empty to use the manual https://wa.me/ deep link instead.
VITE_WHATSAPP_WEBHOOK_URL=

# ---------------------------------------------------------------------
# Bulk WhatsApp gateway (server/ folder — see WHATSAPP_BULK_SETUP.md)
# ---------------------------------------------------------------------
# Leave the URL empty in development: Vite proxies /api/whatsapp to
# http://127.0.0.1:4000 automatically. In production set the public URL of
# the gateway, e.g. https://wa.yourdomain.com/api/whatsapp
VITE_WHATSAPP_GATEWAY_URL=
# Must match WA_API_KEY in server/.env when the gateway requires a key.
VITE_WHATSAPP_API_KEY=
