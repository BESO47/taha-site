# Browser-safe Supabase project credentials (Project Settings -> API).
# The anon/publishable key is intentionally public; RLS is the security boundary.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Keep this relative in production and reverse-proxy it to the Node gateway.
# A custom cross-origin gateway also requires a matching CSP connect-src rule.
VITE_WHATSAPP_GATEWAY_URL=/api/whatsapp

# Never put service-role keys, WhatsApp tokens, webhook credentials, or shared
# API keys in a VITE_ variable: every VITE_ value is shipped to the browser.
